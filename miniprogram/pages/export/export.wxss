.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #f5f6f8;
}

.card {
  margin-bottom: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f1f4;
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #2b3140;
}

.value {
  font-size: 28rpx;
  color: #6b7385;
}

.hint {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8b93a3;
}

.hint-error {
  color: #cf1322;
}

.warn {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background-color: #fff7e6;
}

.warn-line {
  display: block;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #ad6800;
}

.footer {
  margin-top: 32rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 30rpx;
}

.btn + .btn {
  margin-top: 16rpx;
}

.btn-primary {
  background-color: #4c8dff;
  color: #ffffff;
}

.btn-ghost {
  background-color: #eef1f6;
  color: #2b3140;
}

.btn-disabled {
  opacity: 0.4;
}

.progress {
  padding: 24rpx 0 8rpx;
}

.bar {
  height: 16rpx;
  border-radius: 999rpx;
  background-color: #eef1f6;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background-color: #4c8dff;
  transition: width 200ms linear;
}

.progress-text {
  display: block;
  margin: 16rpx 0;
  font-size: 24rpx;
  color: #6b7385;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.done-title {
  display: block;
  padding-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1f2b;
}

.done-line {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7385;
}

.done-tip {
  display: block;
  margin: 12rpx 0 24rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8b93a3;
}
