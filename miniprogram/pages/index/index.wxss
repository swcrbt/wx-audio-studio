.page {
  min-height: 100vh;
  padding: 24rpx;
  background-color: #f5f6f8;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.primary-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  background-color: #4c8dff;
  color: #ffffff;
  font-size: 30rpx;
}

.header-actions {
  display: flex;
  gap: 12rpx;
}

.ghost-btn {
  padding: 0 28rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  color: #2b3140;
  font-size: 28rpx;
}

.usage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
  font-size: 24rpx;
  color: #6b7385;
}

.usage-warn {
  background-color: #fff7e6;
  color: #ad6800;
}

.usage-critical {
  background-color: #fff1f0;
  color: #cf1322;
}

.usage-clean {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background-color: #4c8dff;
  color: #ffffff;
  font-size: 22rpx;
}

.resume {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background-color: #eef4ff;
  color: #1d39c4;
  font-size: 26rpx;
}

.import-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background-color: #1c2029;
  color: #ffffff;
  font-size: 24rpx;
}

.import-name {
  max-width: 45%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  opacity: 0.7;
}

.list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #ffffff;
}

.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1f2b;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-meta {
  font-size: 22rpx;
  color: #8b93a3;
  font-variant-numeric: tabular-nums;
}

.card-more {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: #8b93a3;
  font-size: 34rpx;
}
