.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 20;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 21;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  background-color: #1c2029;
  transform: translateY(110%);
  transition: transform 200ms ease-out;
}

.sheet-open {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.sheet-done {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background-color: #4c8dff;
  color: #ffffff;
  font-size: 26rpx;
}

.sheet-body {
  flex: 1;
  padding: 0 32rpx;
}

.field {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.field:last-child {
  border-bottom: none;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  font-size: 26rpx;
  color: #d6dae3;
}

.field-value {
  font-size: 26rpx;
  color: #4c8dff;
  font-variant-numeric: tabular-nums;
}

.field-slider {
  margin: 8rpx 0 0;
}

.field-switch {
  display: flex;
  justify-content: flex-end;
  padding-top: 8rpx;
}

.segments {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.segment {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background-color: #262b36;
  color: #c6ccd8;
  font-size: 24rpx;
}

.segment-on {
  background-color: #4c8dff;
  color: #ffffff;
}

.action {
  margin-top: 8rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 16rpx;
  background-color: #262b36;
  color: #d6dae3;
  font-size: 26rpx;
}

.sheet-pad {
  height: 48rpx;
}
