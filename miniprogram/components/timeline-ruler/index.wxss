.ruler {
  position: relative;
  width: 100%;
  height: 36rpx;
  overflow: hidden;
  background-color: #12151a;
}

.tick {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 0;
}

.tick-line {
  position: absolute;
  top: 20rpx;
  left: 0;
  width: 1px;
  height: 16rpx;
  background-color: rgba(255, 255, 255, 0.18);
}

.tick-label {
  position: absolute;
  top: 0;
  left: 6rpx;
  font-size: 20rpx;
  line-height: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  white-space: nowrap;
  /* 时间数字用等宽，避免跳动 */
  font-variant-numeric: tabular-nums;
}
